        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; -------------------- 5. ACTIVITY: UC-04 --------------------\n@startuml Sada_Activity_UC04\ntitle UC-04 — Review Suspicious Case\nskinparam shadowing false\nskinparam defaultFontName Arial\nstart\n:Reviewer authenticates to staff dashboard;\n:Open review case queue;\n:Select an OPEN case;\n:Claim case and set status to IN_REVIEW;\n:Load customer, transfer or ticket details;\n:Display triggered rules and assessment metadata;\nif (Retained audio copy available?) then (Yes)\n :Reviewer listens to retained recording;\nelse (No)\n :Display audio unavailable notice;\nendif\n:Reviewer evaluates available evidence;\n:Enter decision rationale;\nif (Reviewer accepts case?) then (Accept)\n :Begin atomic database transaction;\n :Set case status to ACCEPTED;\n if (Case contains held transfer?) then (Yes)\n  :Release frozen amount for settlement;\n  :Lock source and destination accounts;\n  :Post balanced debit and credit entries;\n  :Update account balances;\n  :Set transfer status to COMPLETED;\n else (No)\n  :Approve sensitive support request;\n endif\n :Append immutable audit event;\n :Commit transaction;\nelse (Reject)\n :Begin atomic database transaction;\n :Set case status to REJECTED;\n if (Case contains held transfer?) then (Yes)\n  :Cancel held transfer;\n  :Restore frozen amount to available balance;\n else (No)\n  :Reject sensitive support request;\n endif\n :Append immutable audit event;\n :Commit transaction;\nendif\n:Delete retained audio copy according to retention policy;\n:Record reviewer, rationale and decision timestamp;\n:Notify customer;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vPecKsJ7qy07KvzmN1Pw-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
