        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; -------------------- 8. SYSTEM SEQUENCE (SSD): UC-03 --------------------\n@startuml Sada_Sequence_UC03\ntitle UC-03 — Analyze Audio Recording (System Sequence Diagram)\nautonumber\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam sequence {\n  ActorBorderColor #334155\n  ParticipantBorderColor #334155\n  ParticipantBackgroundColor #F8FAFC\n  LifeLineBorderColor #64748B\n  ArrowColor #334155\n}\n\nparticipant \&quot;Sada Platform\&quot; as Platform\nparticipant \&quot;Sada AI Service\&quot; as AI\n\nPlatform -&gt; AI: requestAudioAssessment(ticketId, audioPayload)\nAI -&gt; AI: writeTemporaryScratchCopy(),\\nvalidateHeaderAndIntegrity()\n\nalt File is corrupted or unsupported\n  AI -&gt; AI: recordValidationFailure(),\\ndeleteScratchCopy()\n  AI --&gt; Platform: returnInvalidAudioResult(status=\&quot;INVALID_AUDIO\&quot;)\nelse File is valid\n  AI -&gt; AI: measureQualityIndicators(duration, silenceRatio, clipping)\n\n  alt Audio quality is insufficient\n    AI -&gt; AI: storeInsufficientQualityAssessment(),\\ndeleteScratchCopy()\n    AI --&gt; Platform: returnQualityOutcome(status=\&quot;INSUFFICIENT_QUALITY\&quot;)\n  else Audio quality is sufficient\n    AI -&gt; AI: convertToMono16kHz(), normalizeAndSegment(),\\nrunDeepfakeClassifier(), aggregateSpoofScore()\n    AI -&gt; AI: storeAssessmentMetadata(spoofScore, threshold,\\nmodelVersion, processingTime), deleteScratchCopy()\n    AI --&gt; Platform: returnAssessmentResult(spoofScore, qualityStatus, modelVersion)\n  end\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TgTziPrXvUSxa3XX-cSn-1">
