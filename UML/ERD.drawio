  <diagram name="Page-1" id="LnfpJF1CPosomYOY9hgW">
    <mxGraphModel dx="2512" dy="1527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; -------------------- 10. ERD --------------------\n@startuml Sada_ERD\ntitle Sada Digital Banking Platform — ERD\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam class {\n  BackgroundColor #F8FAFC\n  BorderColor #334155\n  ArrowColor #475569\n  FontSize 11\n}\n\nentity \&quot;USER\&quot; as User {\n * user_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * full_name : varchar(120)\n * email : varchar(150) &lt;&lt;UQ&gt;&gt;\n * password_hash : varchar(255)\n * status : varchar(20)\n * created_at : timestamp\n}\nentity \&quot;ROLE\&quot; as Role {\n * role_id : int &lt;&lt;PK&gt;&gt;\n --\n * role_name : varchar(40) &lt;&lt;UQ&gt;&gt;\n}\nentity \&quot;USER_ROLE\&quot; as UserRole {\n * user_id : UUID &lt;&lt;PK, FK&gt;&gt;\n * role_id : int &lt;&lt;PK, FK&gt;&gt;\n --\n * assigned_at : timestamp\n}\nentity \&quot;BANK_ACCOUNT\&quot; as Account {\n * account_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * customer_id : UUID &lt;&lt;FK, UQ&gt;&gt;\n * account_number : varchar(34) &lt;&lt;UQ&gt;&gt;\n * currency : char(3)\n * available_balance : decimal(18,2)\n * frozen_balance : decimal(18,2)\n * daily_limit : decimal(18,2)\n * status : varchar(20)\n * created_at : timestamp\n}\nentity \&quot;TRANSFER\&quot; as Transfer {\n * transfer_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * source_account_id : UUID &lt;&lt;FK&gt;&gt;\n * destination_account_id : UUID &lt;&lt;FK&gt;&gt;\n * initiated_by : UUID &lt;&lt;FK&gt;&gt;\n * amount : decimal(18,2)\n * status : varchar(20)\n * created_at : timestamp\n completed_at : timestamp nullable\n}\nentity \&quot;LEDGER_TRANSACTION\&quot; as LedgerTx {\n * ledger_tx_id : UUID &lt;&lt;PK&gt;&gt;\n --\n transfer_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n reversal_of_id : UUID &lt;&lt;FK, UQ, nullable&gt;&gt;\n * transaction_type : varchar(30)\n * status : varchar(20)\n * created_at : timestamp\n posted_at : timestamp nullable\n}\nentity \&quot;LEDGER_ENTRY\&quot; as Entry {\n * entry_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * ledger_tx_id : UUID &lt;&lt;FK&gt;&gt;\n * account_id : UUID &lt;&lt;FK&gt;&gt;\n * entry_type : varchar(10)\n * amount : decimal(18,2)\n * created_at : timestamp\n}\nentity \&quot;SUPPORT_TICKET\&quot; as Ticket {\n * ticket_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * customer_id : UUID &lt;&lt;FK&gt;&gt;\n * account_id : UUID &lt;&lt;FK&gt;&gt;\n related_transfer_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n * request_type : varchar(50)\n * description : text\n * status : varchar(30)\n * created_at : timestamp\n}\nentity \&quot;AUDIO_FILE\&quot; as Audio {\n * audio_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * ticket_id : UUID &lt;&lt;FK&gt;&gt;\n * storage_reference : varchar(500)\n * file_format : varchar(10)\n * file_size_bytes : bigint\n * duration_seconds : decimal(5,2)\n * review_copy_status : varchar(20)\n retention_expires_at : timestamp nullable\n deleted_at : timestamp nullable\n * created_at : timestamp\n}\nentity \&quot;AUDIO_ASSESSMENT\&quot; as Assessment {\n * assessment_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * audio_id : UUID &lt;&lt;FK&gt;&gt;\n * status : varchar(30)\n spoof_score : decimal(5,4) nullable\n threshold : decimal(5,4) nullable\n * quality_status : varchar(30)\n * model_version : varchar(80)\n * processing_time_ms : int\n * assessed_at : timestamp\n}\nentity \&quot;REVIEW_CASE\&quot; as ReviewCase {\n * case_id : UUID &lt;&lt;PK&gt;&gt;\n --\n ticket_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n transfer_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n * status : varchar(20)\n * triggered_rules : text\n assigned_reviewer_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n decision : varchar(20) nullable\n decision_rationale : text nullable\n reviewed_at : timestamp nullable\n * created_at : timestamp\n}\nentity \&quot;OTP_CHALLENGE\&quot; as OTP {\n * otp_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * user_id : UUID &lt;&lt;FK&gt;&gt;\n * challenge_hash : varchar(255)\n * expires_at : timestamp\n * status : varchar(20)\n * created_at : timestamp\n}\nentity \&quot;SYSTEM_SETTING\&quot; as Setting {\n * setting_id : UUID &lt;&lt;PK&gt;&gt;\n --\n * setting_key : varchar(100) &lt;&lt;UQ&gt;&gt;\n * setting_value : varchar(255)\n * updated_by : UUID &lt;&lt;FK&gt;&gt;\n * updated_at : timestamp\n}\nentity \&quot;AUDIT_LOG\&quot; as Audit {\n * audit_id : UUID &lt;&lt;PK&gt;&gt;\n --\n actor_user_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n * event_type : varchar(80)\n * entity_type : varchar(40)\n * entity_id : UUID\n * event_details : text\n * created_at : timestamp\n}\n\nUser ||--o| Account : owns\nUser ||--o{ UserRole : assigned\nRole ||--o{ UserRole : grants\nUser ||--o{ OTP : receives\nUser ||--o{ Transfer : initiates\nUser ||--o{ Ticket : submits\nUser |o--o{ ReviewCase : reviews\nAccount ||--o{ Transfer : source\nAccount ||--o{ Transfer : destination\nAccount ||--o{ Entry : records\nTransfer |o--o| LedgerTx : posts\nLedgerTx ||--|{ Entry : contains\nLedgerTx |o--o| LedgerTx : reverses\nAccount ||--o{ Ticket : concerns\nTransfer |o--o{ Ticket : related_to\nTicket ||--o{ Audio : attaches\nAudio ||--o{ Assessment : assessed_by\nTicket |o--o{ ReviewCase : may_create\nTransfer |o--o{ ReviewCase : may_create\nUser ||--o{ Setting : updates\nUser |o--o{ Audit : performs\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vPecKsJ7qy07KvzmN1Pw-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
