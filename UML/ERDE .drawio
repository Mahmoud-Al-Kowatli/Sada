  <diagram name="Page-1" id="gGwM5OHuQJ2tLo40dFEi">
    <mxGraphModel dx="3089" dy="1361" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; -------------------- 10. ERD --------------------\n@startuml Sada_ERD\ntitle Sada Digital Banking Platform — Entity Relationship Diagram\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam class {\n  BackgroundColor #F8FAFC\n  BorderColor #334155\n  ArrowColor #475569\n}\n\nentity \&quot;USER\&quot; as User {\n  * user_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  full_name : varchar\n  email : varchar &lt;&lt;UQ&gt;&gt;\n  password_hash : varchar\n  status : varchar\n  created_at : timestamp\n}\n\nentity \&quot;ROLE\&quot; as Role {\n  * role_id : int &lt;&lt;PK&gt;&gt;\n  --\n  role_name : varchar &lt;&lt;UQ&gt;&gt;\n}\n\nentity \&quot;USER_ROLE\&quot; as UserRole {\n  * user_id : UUID &lt;&lt;PK, FK&gt;&gt;\n  * role_id : int &lt;&lt;PK, FK&gt;&gt;\n}\n\nentity \&quot;BANK_ACCOUNT\&quot; as Account {\n  * account_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  customer_id : UUID &lt;&lt;FK&gt;&gt;\n  account_number : varchar &lt;&lt;UQ&gt;&gt;\n  currency : char(3)\n  available_balance : decimal\n  frozen_balance : decimal\n  status : varchar\n  created_at : timestamp\n}\n\nentity \&quot;TRANSFER\&quot; as Transfer {\n  * transfer_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  source_account_id : UUID &lt;&lt;FK&gt;&gt;\n  destination_account_id : UUID &lt;&lt;FK&gt;&gt;\n  initiated_by : UUID &lt;&lt;FK&gt;&gt;\n  amount : decimal\n  status : varchar\n  created_at : timestamp\n}\n\nentity \&quot;LEDGER_TRANSACTION\&quot; as LedgerTx {\n  * ledger_tx_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  transfer_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n  transaction_type : varchar\n  status : varchar\n  posted_at : timestamp\n  reversal_of_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n}\n\nentity \&quot;LEDGER_ENTRY\&quot; as Entry {\n  * entry_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  ledger_tx_id : UUID &lt;&lt;FK&gt;&gt;\n  account_id : UUID &lt;&lt;FK&gt;&gt;\n  entry_type : varchar\n  amount : decimal\n  created_at : timestamp\n}\n\nentity \&quot;SUPPORT_TICKET\&quot; as Ticket {\n  * ticket_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  customer_id : UUID &lt;&lt;FK&gt;&gt;\n  account_id : UUID &lt;&lt;FK&gt;&gt;\n  request_type : varchar\n  description : text\n  status : varchar\n  created_at : timestamp\n}\n\nentity \&quot;AUDIO_FILE\&quot; as Audio {\n  * audio_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  ticket_id : UUID &lt;&lt;FK&gt;&gt;\n  storage_reference : varchar\n  format : varchar\n  duration_seconds : decimal\n  quality_status : varchar\n  uploaded_at : timestamp\n  deleted_at : timestamp\n}\n\nentity \&quot;AUDIO_ASSESSMENT\&quot; as Assessment {\n  * assessment_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  audio_id : UUID &lt;&lt;FK&gt;&gt;\n  spoof_score : decimal\n  threshold : decimal\n  quality_status : varchar\n  model_version : varchar\n  processing_time_ms : int\n  assessment_status : varchar\n  created_at : timestamp\n}\n\nentity \&quot;REVIEW_CASE\&quot; as ReviewCase {\n  * case_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  ticket_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n  transfer_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n  assigned_reviewer_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n  status : varchar\n  risk_score : decimal\n  decision : varchar\n  decision_rationale : text\n  created_at : timestamp\n  reviewed_at : timestamp\n}\n\nentity \&quot;OTP_CHALLENGE\&quot; as OTP {\n  * otp_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  purpose : varchar\n  expires_at : timestamp\n  verified_at : timestamp\n  status : varchar\n}\n\nentity \&quot;SYSTEM_SETTING\&quot; as Setting {\n  * setting_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  setting_key : varchar &lt;&lt;UQ&gt;&gt;\n  setting_value : varchar\n  updated_by : UUID &lt;&lt;FK&gt;&gt;\n  updated_at : timestamp\n}\n\nentity \&quot;AUDIT_LOG\&quot; as Audit {\n  * audit_id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  actor_user_id : UUID &lt;&lt;FK, nullable&gt;&gt;\n  action : varchar\n  entity_type : varchar\n  entity_id : UUID\n  details : text\n  created_at : timestamp\n}\n\nUser ||--o{ UserRole\nRole ||--o{ UserRole\nUser ||--o{ Account : owns\nAccount ||--o{ Transfer : source\nAccount ||--o{ Transfer : destination\nUser ||--o{ Transfer : initiates\nTransfer ||--o| LedgerTx : posts\nLedgerTx ||--|{ Entry : contains\nAccount ||--o{ Entry : receives\nLedgerTx |o--o| LedgerTx : reverses\nUser ||--o{ Ticket : opens\nAccount ||--o{ Ticket : relates to\nTicket ||--o{ Audio : attaches\nAudio ||--o{ Assessment : assessed by\nTicket ||--o{ ReviewCase : may create\nTransfer ||--o{ ReviewCase : may create\nUser |o--o{ ReviewCase : reviews\nUser ||--o{ OTP : receives\nUser |o--o{ Setting : updates\nUser |o--o{ Audit : performs\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TgTziPrXvUSxa3XX-cSn-1">
