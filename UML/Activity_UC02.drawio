        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; -------------------- 3. ACTIVITY: UC-02 --------------------\n@startuml Sada_Activity_UC02\ntitle UC-02 — Submit Sensitive Support Request\nskinparam shadowing false\nskinparam defaultFontName Arial\nstart\n:Customer selects sensitive request type;\n:Enter request details and attach voice recording;\n:Authenticate customer session;\nif (Session valid?) then (Yes)\n :Validate audio extension, size and file header;\n if (Audio file accepted?) then (Yes)\n  :Create support ticket linked to customer and account;\n  :Store encrypted retained review copy;\n  :Send audio payload to Sada AI;\n  if (AI assessment available?) then (Yes)\n   :Receive spoof score and quality status;\n   :Evaluate result using platform Risk Engine;\n   if (Manual review required?) then (Yes)\n    :Suspend sensitive operation;\n    :Open review case linked to ticket;\n    :Set ticket status to PENDING_REVIEW;\n   else (No)\n    :Set ticket status to SUBMITTED;\n    :Route ticket to standard support workflow;\n   endif\n  else (No)\n   :Mark AI assessment as UNAVAILABLE;\n   :Apply non-AI risk rules;\n   if (Manual review required?) then (Yes)\n    :Open review case linked to ticket;\n    :Set ticket status to PENDING_REVIEW;\n   else (No)\n    :Set ticket status to SUBMITTED;\n   endif\n  endif\n  :Append audit event;\n  :Return ticket reference and status;\n else (No)\n  :Reject unsupported or oversized audio file;\n endif\nelse (No)\n :Reject unauthenticated request;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vPecKsJ7qy07KvzmN1Pw-1">
