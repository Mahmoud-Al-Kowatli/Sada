  <diagram name="Page-1" id="gGwM5OHuQJ2tLo40dFEi">
    <mxGraphModel dx="6909" dy="3682" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; -------------------- 11. CLASS DIAGRAM --------------------\n@startuml Sada_Class_Diagram\ntitle Sada Digital Banking Platform — Domain &amp; Service Class Diagram\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam classAttributeIconSize 0\nskinparam class {\n  BackgroundColor #F8FAFC\n  BorderColor #334155\n  ArrowColor #475569\n}\nskinparam enum {\n  BackgroundColor #F1F5F9\n  BorderColor #334155\n}\n\npackage \&quot;Enumerations\&quot; {\n  enum RoleName {\n    CUSTOMER\n    REVIEW_EMPLOYEE\n    SYSTEM_ADMIN\n  }\n\n  enum TransferStatus {\n    PENDING\n    HELD\n    COMPLETED\n    CANCELLED\n    REJECTED\n  }\n\n  enum EntryType {\n    DEBIT\n    CREDIT\n  }\n\n  enum TicketStatus {\n    SUBMITTED\n    PENDING_REVIEW\n    APPROVED\n    REJECTED\n  }\n\n  enum AudioQualityStatus {\n    SUFFICIENT\n    INSUFFICIENT_QUALITY\n    INVALID_AUDIO\n  }\n\n  enum AssessmentStatus {\n    COMPLETED\n    FAILED\n    UNAVAILABLE\n  }\n\n  enum CaseStatus {\n    OPEN\n    IN_REVIEW\n    ACCEPTED\n    REJECTED\n  }\n}\n\npackage \&quot;Sada Platform — Domain Model\&quot; {\n  class User {\n    +userId : UUID\n    +fullName : String\n    +email : String\n    -passwordHash : String\n    +status : String\n    +createdAt : DateTime\n    +hasRole(role : RoleName) : Boolean\n  }\n\n  class Role {\n    +roleId : int\n    +roleName : RoleName\n  }\n\n  class BankAccount {\n    +accountId : UUID\n    +accountNumber : String\n    +currency : String\n    +availableBalance : Decimal\n    +frozenBalance : Decimal\n    +dailyLimit : Decimal\n    +status : String\n    +freezeAmount(amount : Decimal) : void\n    +unfreezeAmount(amount : Decimal) : void\n    +debit(amount : Decimal) : void\n    +credit(amount : Decimal) : void\n  }\n\n  class Transfer {\n    +transferId : UUID\n    +amount : Decimal\n    +status : TransferStatus\n    +createdAt : DateTime\n    +completedAt : DateTime\n    +markHeld() : void\n    +markCompleted() : void\n    +markCancelled() : void\n  }\n\n  class LedgerTransaction {\n    +ledgerTxId : UUID\n    +transactionType : String\n    +status : String\n    +postedAt : DateTime\n    +reversalOfId : UUID\n    +isBalanced() : Boolean\n  }\n\n  class LedgerEntry {\n    +entryId : UUID\n    +entryType : EntryType\n    +amount : Decimal\n    +createdAt : DateTime\n  }\n\n  class OtpChallenge {\n    +otpId : UUID\n    +purpose : String\n    +expiresAt : DateTime\n    +verifiedAt : DateTime\n    +status : String\n    +verify(code : String) : Boolean\n  }\n\n  class SupportTicket {\n    +ticketId : UUID\n    +requestType : String\n    +description : String\n    +status : TicketStatus\n    +createdAt : DateTime\n    +updateStatus(status : TicketStatus) : void\n  }\n\n  class AudioFile {\n    +audioId : UUID\n    +storageReference : String\n    +format : String\n    +sizeBytes : long\n    +durationSeconds : Decimal\n    +reviewCopyStatus : String\n    +retentionExpiresAt : DateTime\n    +deletedAt : DateTime\n    +markDeleted() : void\n  }\n\n  class AudioAssessment {\n    +assessmentId : UUID\n    +spoofScore : Decimal\n    +threshold : Decimal\n    +qualityStatus : AudioQualityStatus\n    +modelVersion : String\n    +processingTimeMs : int\n    +assessmentStatus : AssessmentStatus\n    +createdAt : DateTime\n    +isSuspicious() : Boolean\n  }\n\n  class ReviewCase {\n    +caseId : UUID\n    +status : CaseStatus\n    +triggeredRules : String\n    +riskScore : Decimal\n    +decision : String\n    +decisionRationale : String\n    +createdAt : DateTime\n    +reviewedAt : DateTime\n    +claim(reviewerId : UUID) : void\n    +recordDecision(decision : String, rationale : String) : void\n  }\n\n  class SystemSetting {\n    +settingId : UUID\n    +settingKey : String\n    +settingValue : String\n    +updatedAt : DateTime\n  }\n\n  class AuditLog {\n    +auditId : UUID\n    +action : String\n    +entityType : String\n    +entityId : UUID\n    +details : String\n    +createdAt : DateTime\n  }\n}\n\npackage \&quot;Sada Platform — Application Services\&quot; {\n  class AuthService {\n    +authenticate(email : String, password : String) : SessionToken\n    +generateOtp(userId : UUID, purpose : String) : OtpChallenge\n    +verifyOtp(userId : UUID, code : String) : Boolean\n  }\n\n  class TransferService {\n    +executeInternalTransfer(sourceId : UUID, destId : UUID, amount : Decimal, otpCode : String) : Transfer\n    +releaseHeldTransfer(transferId : UUID) : void\n    +cancelHeldTransfer(transferId : UUID) : void\n  }\n\n  class LedgerService {\n    +postDoubleEntry(transfer : Transfer) : LedgerTransaction\n    +reverseTransaction(ledgerTxId : UUID, reason : String) : LedgerTransaction\n  }\n\n  class RiskEngine {\n    +evaluateTransferRisk(transfer : Transfer, account : BankAccount) : RiskDecision\n    +evaluateSupportRisk(ticket : SupportTicket, assessment : AudioAssessment) : RiskDecision\n  }\n\n  class SupportTicketService {\n    +submitSensitiveRequest(customerId : UUID, accountId : UUID, type : String, audio : Binary) : SupportTicket\n  }\n\n  class CaseManagementService {\n    +listOpenCases() : List&lt;ReviewCase&gt;\n    +getCaseDetails(caseId : UUID) : ReviewCase\n    +submitDecision(caseId : UUID, reviewerId : UUID, decision : String, rationale : String) : ReviewCase\n  }\n\n  class AuditService {\n    +appendEvent(actorId : UUID, action : String, entityType : String, entityId : UUID, details : String) : AuditLog\n  }\n\n  class SadaAIServiceClient {\n    +requestAssessment(ticketId : UUID, audioBytes : Binary) : AudioAssessment\n  }\n}\n\npackage \&quot;Sada AI Microservice\&quot; {\n  class AudioAssessmentAPI {\n    +analyzeAudio(ticketId : UUID, file : Binary) : AssessmentResponse\n  }\n\n  class AudioValidator {\n    +validateHeaderAndFormat(filePath : String) : Boolean\n    +assessQuality(filePath : String) : AudioQualityStatus\n  }\n\n  class AudioPreprocessor {\n    +convertToMono16kHz(filePath : String) : Signal\n    +segmentWindows(signal : Signal, windowSec : float) : List&lt;Window&gt;\n  }\n\n  class DeepfakeClassifier {\n    +modelVersion : String\n    +threshold : Decimal\n    +predictSpoofScore(windows : List&lt;Window&gt;) : Decimal\n  }\n}\n\n&#39; Domain Relationships\nUser \&quot;1\&quot; -- \&quot;1..*\&quot; Role : has &gt;\nUser \&quot;1\&quot; *-- \&quot;0..*\&quot; BankAccount : owns &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; OtpChallenge : receives &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; AuditLog : triggers &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; SystemSetting : updates &gt;\n\nBankAccount \&quot;1\&quot; -- \&quot;0..*\&quot; Transfer : source/dest &gt;\nTransfer \&quot;1\&quot; -- \&quot;0..1\&quot; LedgerTransaction : posts &gt;\nLedgerTransaction \&quot;1\&quot; *-- \&quot;2..*\&quot; LedgerEntry : contains &gt;\nBankAccount \&quot;1\&quot; -- \&quot;0..*\&quot; LedgerEntry : records &gt;\nLedgerTransaction \&quot;0..1\&quot; -- \&quot;0..1\&quot; LedgerTransaction : reverses &gt;\n\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; SupportTicket : submits &gt;\nBankAccount \&quot;1\&quot; -- \&quot;0..*\&quot; SupportTicket : relates to &gt;\nSupportTicket \&quot;1\&quot; *-- \&quot;0..*\&quot; AudioFile : attaches &gt;\nAudioFile \&quot;1\&quot; *-- \&quot;0..*\&quot; AudioAssessment : evaluated by &gt;\n\nSupportTicket \&quot;0..1\&quot; -- \&quot;0..*\&quot; ReviewCase : escalates to &gt;\nTransfer \&quot;0..1\&quot; -- \&quot;0..*\&quot; ReviewCase : escalates to &gt;\nUser \&quot;0..1\&quot; -- \&quot;0..*\&quot; ReviewCase : assigned to &gt;\n\n&#39; Service Dependencies\nTransferService ..&gt; AuthService : uses\nTransferService ..&gt; RiskEngine : evaluates with\nTransferService ..&gt; LedgerService : posts via\nTransferService ..&gt; CaseManagementService : opens case\nTransferService ..&gt; AuditService : logs via\n\nSupportTicketService ..&gt; AuthService : uses\nSupportTicketService ..&gt; SadaAIServiceClient : requests assessment\nSupportTicketService ..&gt; RiskEngine : evaluates with\nSupportTicketService ..&gt; CaseManagementService : opens case\nSupportTicketService ..&gt; AuditService : logs via\n\nCaseManagementService ..&gt; LedgerService : releases/cancels via\nCaseManagementService ..&gt; AuditService : logs via\n\nSadaAIServiceClient ..&gt; AudioAssessmentAPI : HTTP/REST\nAudioAssessmentAPI ..&gt; AudioValidator : validates with\nAudioAssessmentAPI ..&gt; AudioPreprocessor : preprocesses with\nAudioAssessmentAPI ..&gt; DeepfakeClassifier : infers with\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TgTziPrXvUSxa3XX-cSn-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 380 10 10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
