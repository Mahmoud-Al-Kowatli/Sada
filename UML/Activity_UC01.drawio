      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; -------------------- 2. ACTIVITY: UC-01 --------------------\n@startuml Sada_Activity_UC01\ntitle UC-01 — Execute Internal Transfer\nskinparam shadowing false\nskinparam defaultFontName Arial\nstart\n:Customer enters destination account and amount;\n:Submit transfer request;\n:Authenticate customer session;\nif (Session valid?) then (Yes)\n :Verify simulated OTP challenge;\n if (OTP valid?) then (Yes)\n  :Check source account status;\n  if (Account active?) then (Yes)\n   :Check available balance;\n   if (Sufficient balance?) then (Yes)\n    :Check daily transfer limit;\n    if (Limit not exceeded?) then (Yes)\n     :Evaluate transaction risk rules;\n     if (Manual review required?) then (Yes)\n      :Begin database transaction;\n      :Lock source account and recheck balance;\n      :Move amount from available to frozen balance;\n      :Create transfer with HELD status;\n      :Open linked review case;\n      :Append audit event;\n      :Commit transaction;\n      :Notify customer that transfer is pending review;\n     else (No)\n      :Begin atomic database transaction;\n      :Lock source and destination accounts;\n      :Recheck available balance;\n      :Create balanced debit and credit ledger entries;\n      :Post ledger transaction;\n      :Update account balances;\n      :Create transfer with COMPLETED status;\n      :Append audit event;\n      :Commit transaction;\n      :Display transfer receipt;\n     endif\n    else (No)\n     :Reject transfer because daily limit is exceeded;\n     :Append rejection audit event;\n    endif\n   else (No)\n    :Reject transfer because funds are insufficient;\n    :Append rejection audit event;\n   endif\n  else (No)\n   :Reject transfer because source account is inactive;\n   :Append rejection audit event;\n  endif\n else (No)\n  :Reject transfer because OTP is invalid;\n  :Append failed OTP audit event;\n endif\nelse (No)\n :Reject unauthenticated request;\n :Append authentication failure audit event;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3XM052n9Bf0rAu2ZNSKN-1">
